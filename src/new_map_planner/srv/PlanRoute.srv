# start is expressed in the navigation map frame.
geometry_msgs/Pose start
uint8 START_MODE_NORMAL=0
uint8 START_MODE_TURN_RECOVERY=1
uint8 START_MODE_OBSTACLE_RECOVERY=2
uint8 start_mode
# Recovery fields are required only for START_MODE_TURN_RECOVERY.
string recovery_anchor_node_id
string incoming_lane_id
bool allow_reverse_departure
string mode
string[] target_ids
string[] required_lane_ids
string[] completed_lane_ids
# Dynamic obstacle polygons are also expressed in the navigation map frame.
geometry_msgs/Polygon[] dynamic_obstacles
# Preferred online corridor input: physical lane IDs are blocked in both directions.
string[] blocked_lane_ids
uint64 obstacle_revision
# Explicit collision/footprint validation switches. Either true enables checks.
bool validate_geometry
bool online_geometry_validation
bool return_home
bool allow_partial
bool activate
# Number of ordinary junctions visited since the last task junction.
uint8 ordinary_nodes_since_task
bool ordinary_nodes_since_task_exact
---
bool success
bool activated
string message
new_map_planner/RoutePlan plan
float64 planning_time_ms
